<template>
  <div class="root-container" onswipe="exit">
    <!-- 启动即时加载状态（仅在首次冷启动且无内存缓存时展示） -->
    <div class="loading-view" if="{{!isLoaded}}">
      <div class="header-item">
        <text class="header-title">BandTOTP</text>
      </div>
      <div class="loading-body">
        <text class="loading-text">正在载入...</text>
      </div>
    </div>

    <!-- 主列表 -->
    <list class="main-list" id="list" show="{{isLoaded && list.length > 0 && !more_show && !ab}}">
      <!-- 顶部信息栏 -->
      <list-item type="header" class="header-item">
        <text class="header-title">BandTOTP</text>
        <img class="header-info-btn" src="/common/info.png" onclick="i()"/>
      </list-item>

      <!-- 验证码卡片（显式设定 94px 高度，保证虚拟列表正确渲染） -->
      <list-item type="card" for="{{list}}" class="card-item" onclick="info($idx)">
        <text class="card-name">{{$item.name}}</text>
        <text class="card-usr">{{$item.usr}}</text>
        <div class="card-bottom-row">
          <text class="card-otp">{{$item.otp}}</text>
          <text class="card-time">{{timelast}}s</text>
        </div>
      </list-item>

      <!-- 底部统计 -->
      <list-item type="footer" class="footer-item">
        <text class="footer-text">{{list.length}} 个验证器</text>
      </list-item>
    </list>

    <!-- 空状态（已载入但无验证码） -->
    <div class="empty-view" if="{{isLoaded && list.length === 0 && !ab}}">
      <div class="empty-header">
        <img class="header-info-btn" src="/common/info.png" onclick="i()"/>
      </div>
      <div class="empty-body">
        <img class="empty-icon" src="/common/nokey.png"/>
      </div>
    </div>

    <!-- 验证码详情页面 -->
    <div class="overlay-view" show="{{more_show}}">
      <div class="overlay-top-bar">
        <img class="action-btn" src="/common/back.png" onclick="exit('e')"/>
        <img class="action-btn" src="/common/del.png" onclick="del()"/>
      </div>
      <div class="detail-body">
        <text class="detail-name">{{more.name}}</text>
        <text class="detail-usr">{{more.usr}}</text>
        <text class="detail-otp">{{more.otp}}</text>
        <text class="detail-time">有效时间剩余 {{timelast}} 秒</text>
      </div>
    </div>

    <!-- 关于页面 -->
    <div class="overlay-view" show="{{ab}}">
      <div class="overlay-top-bar">
        <img class="action-btn" src="/common/back.png" onclick="exit('e')"/>
        <text class="bar-title">关于</text>
        <div style="width: 44px; height: 30px;"></div>
      </div>
      <list class="about-list">
        <list-item type="ab-logo" class="about-item-logo">
          <img class="about-logo" src="/common/logo.png"/>
        </list-item>
        <list-item type="ab-title" class="about-item-title">
          <text class="about-app-name">BandTOTP</text>
          <text class="about-version">Version 1.1</text>
        </list-item>
        <list-item type="ab-tag" class="about-item-tag">
          <text class="about-tag-text">离线安全双重认证</text>
        </list-item>
        <list-item type="ab-dev" class="about-item-dev">
          <text class="about-dev-title">Developers</text>
          <text class="about-dev-name">无源流沙</text>
          <text class="about-dev-name">乐色桶</text>
        </list-item>
        <list-item type="ab-foot" class="about-item-foot">
          <text class="about-foot-text">Powered by Xiaomi Vela</text>
        </list-item>
      </list>
    </div>
  </div>
</template>

<script>
var totp = require('./totp');
var precomputeKey = totp.precomputeKey;
var fastTOTP = totp.fastTOTP;
var fastSteamTotp = totp.fastSteamTotp;

import prompt from '@system.prompt';
import interconnect from '@system.interconnect';
import storage from "@system.storage";

let timeInterval = null;
let delTimeout = null;
let delCount = false;
let nowi = 0;
let memoryCacheList = null; // 全局内存缓存：防止息屏/亮屏时闪烁“正在载入”

const conn = interconnect.instance();
const dataKey = 'keys';

// 密钥项：预计算 HMAC-SHA1 状态
class KeyItem {
    constructor(key, name, usr) {
        this.name = name || 'OTP';
        this.usr = usr || '';
        this.key = key || '';
        this.isSteam = (this.name && this.name.toLowerCase() === "steam");
        this.prec = precomputeKey(this.key);
        this.otp = '------';
        this.upd();
    }
    upd(timeDiv30) {
        if (this.isSteam) {
            this.otp = fastSteamTotp(this.prec, timeDiv30);
        } else {
            this.otp = fastTOTP(this.prec, timeDiv30);
        }
    }
}

export default {
    private: {
        isLoaded: false,
        ab: false,
        list: [],
        more_show: false,
        more: null,
        timelast: 30,
        lastDiv30: 0
    },
    onInit() {
        // 1. 优先使用 RAM 内存缓存：若已有数据，0ms 瞬时进入就绪状态，彻底杜绝息屏唤醒时出现“正在载入”
        if (memoryCacheList && memoryCacheList.length > 0) {
            this.list = memoryCacheList;
            this.isLoaded = true;
            this.updateAllOtp();
        }

        // 2. 异步 Flash 数据读取与校验
        storage.get({
            key: dataKey,
            success: (data) => {
                if (data) {
                    try {
                        const parsed = typeof data === 'string' ? JSON.parse(data) : data;
                        if (parsed && Array.isArray(parsed.list)) {
                            this.list = parsed.list.map(e => new KeyItem(e.key, e.name, e.usr));
                            memoryCacheList = this.list;
                        }
                    } catch (err) {}
                }
                this.isLoaded = true;
                this.updateAllOtp();
            },
            fail: () => {
                this.isLoaded = true;
            },
            complete: () => {
                this.isLoaded = true;
            }
        });

        conn.onmessage = (data) => {
            try {
                const raw = data && data.data ? data.data : data;
                const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
                const d = parsed && Array.isArray(parsed.list) ? parsed.list : [];
                d.forEach((e) => {
                    const index = this.list.findIndex((a) => e.key === a.key);
                    if (index !== -1) {
                        this.list[index].name = e.name || this.list[index].name;
                        this.list[index].usr = e.usr || '';
                        this.list[index].isSteam = (this.list[index].name && this.list[index].name.toLowerCase() === "steam");
                        this.list[index].prec = precomputeKey(this.list[index].key);
                        this.list[index].upd();
                    } else {
                        this.list.push(new KeyItem(e.key, e.name, e.usr));
                    }
                });
                memoryCacheList = this.list;
                this.save();
                this.updateAllOtp();
                prompt.showToast({
                    message: "同步成功",
                    duration: 1500
                });
            } catch (error) {
                prompt.showToast({
                    message: "同步异常: " + error.toString(),
                    duration: 2000
                });
            }
        };
    },
    updateAllOtp(timeDiv30) {
        if (!this.list || this.list.length === 0) return;
        const curDiv = timeDiv30 !== undefined ? timeDiv30 : Math.floor(Date.now() / 30000);
        for (let i = 0; i < this.list.length; i++) {
            this.list[i].upd(curDiv);
        }
        if (this.more_show && this.more) {
            this.more.upd(curDiv);
        }
    },
    updateTimers() {
        const now = Date.now();
        const msElapsed = now % 30000;
        const msRemaining = 30000 - msElapsed;

        // 严格同步计算：剩余秒数 (30 ~ 1)，1秒整完整持续到周期翻转瞬间
        this.timelast = Math.max(1, Math.ceil(msRemaining / 1000));

        // 周期翻转刷新 OTP
        const curDiv30 = Math.floor(now / 30000);
        if (curDiv30 !== this.lastDiv30) {
            this.lastDiv30 = curDiv30;
            this.updateAllOtp(curDiv30);
        }
    },
    startTimers() {
        this.stopTimers();
        this.lastDiv30 = Math.floor(Date.now() / 30000);
        this.updateAllOtp(this.lastDiv30);
        this.updateTimers();

        // 500ms 刷新倒计时数字（省电且精准同步）
        timeInterval = setInterval(() => {
            this.updateTimers();
        }, 500);
    },
    stopTimers() {
        if (timeInterval) {
            clearInterval(timeInterval);
            timeInterval = null;
        }
    },
    i() { // 打开关于
        this.ab = true;
    },
    info(idx) { // 打开详情
        nowi = idx;
        this.more = this.list[idx];
        this.more_show = true;
        const ttl = Math.floor((Date.now() / 1000) % 30);
        this.timelast = 30 - ttl;
    },
    exit(a) { // 返回
        if (a === 'e' || (a && a.direction === 'right')) {
            if (this.ab || this.more_show) {
                this.more_show = false;
                this.ab = false;
            } else {
                this.$app.exit();
            }
        }
    },
    onBackPress() {
        this.exit('e');
        return true;
    },
    save() { // 持久化
        const saveObj = {
            list: this.list.map(e => ({ name: e.name, usr: e.usr, key: e.key }))
        };
        storage.set({
            key: dataKey,
            value: JSON.stringify(saveObj)
        });
    },
    onShow() {
        // 亮屏唤醒：若已有缓存直接保持就绪状态并启动定时器
        if (memoryCacheList && memoryCacheList.length > 0) {
            this.list = memoryCacheList;
            this.isLoaded = true;
        }
        this.startTimers();
    },
    onHide() {
        this.stopTimers();
    },
    onDestroy() {
        this.stopTimers();
    },
    del() { // 删除确认
        clearTimeout(delTimeout);
        if (!delCount) {
            delCount = true;
            delTimeout = setTimeout(() => {
                delCount = false;
            }, 1200);
            prompt.showToast({
                message: "再次点击确认删除",
                duration: 1200
            });
            return;
        }
        if (nowi >= 0 && nowi < this.list.length) {
            this.list.splice(nowi, 1);
            delCount = false;
            this.more_show = false;
            memoryCacheList = this.list;
            this.save();
            prompt.showToast({
                message: "已删除",
                duration: 1000
            });
        }
    }
};
</script>

