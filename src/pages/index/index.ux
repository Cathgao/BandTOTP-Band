<template>
  <div class="root-container">
    <!-- 启动即时加载状态（仅在首次冷启动且无内存缓存时展示） -->
    <div class="loading-view" if="{{!isLoaded}}">
      <div class="header-item">
        <text class="header-title">BandTOTP</text>
      </div>
      <div class="loading-body">
        <text class="loading-text">正在载入...</text>
      </div>
    </div>

    <list class="main-list" id="list" bounces="true" show="{{isLoaded && list.length > 0 && !more_show && !ab}}">
      <!-- 顶部信息栏 -->
      <list-item type="header" class="header-item">
        <text class="header-title">BandTOTP</text>
        <div class="header-btn-info" onclick="i()">
          <img class="header-btn-icon-info" src="/common/info_icon.png"/>
        </div>
      </list-item>

      <list-item type="card" for="{{list}}" class="card-item" onclick="info($idx)">
        <text class="card-name">{{$item.name}}</text>
        <text class="card-usr">{{$item.usr}}</text>
        <text class="card-otp">{{$item.otp}}</text>
      </list-item>

      <!-- 底部统计 -->
      <list-item type="footer" class="footer-item">
        <text class="footer-text">{{list.length}} 个验证器</text>
      </list-item>
    </list>

    <!-- 底部独立悬浮倒计时进度条（双端半圆胶囊 + 动态状态色） -->
    <div class="bottom-progress-container" if="{{isLoaded && list.length > 0 && !more_show && !ab}}">
      <progress class="bottom-progress {{progressClass}}" percent="{{timeProgress}}" type="horizontal"></progress>
    </div>

    <!-- 空状态（已载入但无验证码） -->
    <div class="empty-view" if="{{isLoaded && list.length === 0 && !ab}}">
      <div class="empty-header">
        <div class="header-btn-info" onclick="i()">
          <img class="header-btn-icon-info" src="/common/info_icon.png"/>
        </div>
      </div>
      <div class="empty-body">
        <img class="empty-icon" src="/common/nokey.png"/>
      </div>
    </div>

    <!-- 验证码详情页面 -->
    <div class="overlay-view" if="{{more_show}}" onswipe="exit">
      <div class="overlay-top-bar">
        <div class="btn-back" onclick="exit('e')">
          <img class="btn-icon-back" src="/common/back_icon.png"/>
        </div>
        <div class="btn-del" onclick="del()">
          <img class="btn-icon-del" src="/common/del_icon.png"/>
        </div>
      </div>
      <div class="detail-body">
        <text class="detail-name">{{more.name}}</text>
        <text class="detail-usr">{{more.usr}}</text>
        <text class="detail-otp">{{more.otp}}</text>
        <text class="detail-time">有效时间剩余 {{timelast}} 秒</text>
      </div>
    </div>

    <!-- 关于页面 -->
    <div class="overlay-view" if="{{ab}}" onswipe="exit">
      <div class="overlay-top-bar">
        <div class="btn-back" onclick="exit('e')">
          <img class="btn-icon-back" src="/common/back_icon.png"/>
        </div>
        <text class="bar-title">关于</text>
        <div style="width: 38px; height: 26px;"></div>
      </div>
      <list class="about-list">
        <list-item type="ab-logo" class="about-item-logo">
          <img class="about-logo" src="/common/logo.png"/>
        </list-item>
        <list-item type="ab-title" class="about-item-title">
          <text class="about-app-name">BandTOTP</text>
          <text class="about-version">Version 2.2</text>
        </list-item>
        <list-item type="ab-tag" class="about-item-tag">
          <text class="about-tag-text">离线安全双重认证</text>
        </list-item>
        <list-item type="ab-dev" class="about-item-dev">
          <text class="about-dev-title">Developers</text>
          <text class="about-dev-name">无源流沙</text>
          <text class="about-dev-name">乐色桶</text>
          <text class="about-dev-name">Cathgao</text>
        </list-item>
        <list-item type="ab-foot" class="about-item-foot">
          <text class="about-foot-text">Powered by Xiaomi Vela</text>
        </list-item>
      </list>
    </div>
  </div>
</template>

<script>
var totp = require('./totp');
var precomputeKey = totp.precomputeKey;
var fastTOTP = totp.fastTOTP;
var fastSteamTotp = totp.fastSteamTotp;

import prompt from '@system.prompt';
import interconnect from '@system.interconnect';
import storage from "@system.storage";

let alignTimeout = null;
let progressInterval = null;
let timeInterval = null;
let delTimeout = null;
let delCount = false;
let nowi = 0;
let memoryCacheList = null;

let conn = null;
try {
    conn = interconnect.instance();
} catch (e) {}

const dataKey = 'keys';

// 密钥项：预计算 HMAC-SHA1 状态
class KeyItem {
    constructor(key, name, usr, timeDiv30) {
        this.name = name || 'OTP';
        this.usr = usr || '';
        this.key = key || '';
        this.isSteam = (this.name && this.name.toLowerCase() === "steam");
        this.prec = precomputeKey(this.key);
        this.otp = '------';
        this.upd(timeDiv30);
    }
    upd(timeDiv30) {
        if (this.isSteam) {
            this.otp = fastSteamTotp(this.prec, timeDiv30);
        } else {
            this.otp = fastTOTP(this.prec, timeDiv30);
        }
    }
}

export default {
    private: {
        isLoaded: false,
        ab: false,
        list: [],
        more_show: false,
        more: {},
        timelast: 30,
        timeProgress: 100,
        progressClass: 'progress-cyan',
        lastDiv30: 0
    },
    onInit() {
        const curDiv30 = Math.floor(Date.now() / 30000);
        this.lastDiv30 = curDiv30;

        if (memoryCacheList && memoryCacheList.length > 0) {
            this.list = memoryCacheList;
            this.isLoaded = true;
            this.updateAllOtp(curDiv30);
            this.initConn();
            return;
        }

        storage.get({
            key: dataKey,
            success: (data) => {
                if (data) {
                    try {
                        const parsed = typeof data === 'string' ? JSON.parse(data) : data;
                        if (parsed && Array.isArray(parsed.list) && parsed.list.length > 0) {
                            const cur = Math.floor(Date.now() / 30000);
                            this.list = parsed.list.map(e => new KeyItem(e.key, e.name, e.usr, cur));
                            memoryCacheList = this.list;
                        }
                    } catch (err) {}
                }
                this.isLoaded = true;
                this.updateAllOtp(curDiv30);
            },
            fail: () => {
                this.isLoaded = true;
            },
            complete: () => {
                this.isLoaded = true;
            }
        });

        this.initConn();
    },
    initConn() {
        if (!conn) {
            try {
                conn = interconnect.instance();
            } catch (e) {}
        }
        if (conn) {
            conn.onmessage = (data) => {
                try {
                    const raw = data && data.data ? data.data : data;
                    const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
                    const d = parsed && Array.isArray(parsed.list) ? parsed.list : [];
                    const curDiv = Math.floor(Date.now() / 30000);
                    // 智能排序合并：以安卓传入的最新顺序为基准，并安全保留手环端独有的账号
                    const updatedIncomingList = [];
                    const incomingKeySet = {};

                    d.forEach((e) => {
                        if (!e || !e.key) return;
                        incomingKeySet[e.key] = true;
                        const existing = this.list.find((a) => a.key === e.key);
                        if (existing) {
                            existing.name = e.name || existing.name;
                            existing.usr = e.usr || '';
                            existing.isSteam = (existing.name && existing.name.toLowerCase() === "steam");
                            existing.prec = precomputeKey(existing.key);
                            updatedIncomingList.push(existing);
                        } else {
                            updatedIncomingList.push(new KeyItem(e.key, e.name, e.usr, curDiv));
                        }
                    });

                    // 找出仅在手环本地存在但安卓本次未传入的独有账号
                    const bandOnlyItems = this.list.filter((a) => a && a.key && !incomingKeySet[a.key]);

                    // 将手环独有账号追加到末尾
                    this.list = updatedIncomingList.concat(bandOnlyItems);
                    memoryCacheList = this.list;
                    this.save();
                    this.updateAllOtp(curDiv);
                    prompt.showToast({
                        message: "同步成功 (" + d.length + " 个账号)",
                        duration: 1500
                    });
                } catch (error) {
                    prompt.showToast({
                        message: "同步异常: " + error.toString(),
                        duration: 2000
                    });
                }
            };
        }
    },
    updateAllOtp(timeDiv30) {
        if (!this.list || this.list.length === 0) return;
        const curDiv = timeDiv30 !== undefined ? timeDiv30 : Math.floor(Date.now() / 30000);
        for (let i = 0; i < this.list.length; i++) {
            this.list[i].upd(curDiv);
        }
        if (this.more_show && this.more && this.more.upd) {
            this.more.upd(curDiv);
        }
    },
    updateProgress() {
        const now = Date.now();
        const curDiv30 = Math.floor(now / 30000);
        if (curDiv30 !== this.lastDiv30) {
            this.lastDiv30 = curDiv30;
            this.updateAllOtp(curDiv30);
        }
        const msRemaining = 30000 - (now % 30000);
        const secRemaining = Math.max(1, Math.ceil(msRemaining / 1000));

        const newProgress = Math.floor((secRemaining / 30) * 100);
        if (this.timeProgress !== newProgress) {
            this.timeProgress = newProgress;
        }

        if (this.more_show && this.timelast !== secRemaining) {
            this.timelast = secRemaining;
        }

        let newColorClass = 'progress-cyan';
        if (secRemaining <= 5) {
            newColorClass = 'progress-red';
        } else if (secRemaining <= 10) {
            newColorClass = 'progress-orange';
        }
        if (this.progressClass !== newColorClass) {
            this.progressClass = newColorClass;
        }
    },
    startTimers() {
        this.stopTimers();
        const now = Date.now();
        this.updateProgress();

        const ms2NextSec = 1000 - (now % 1000);
        alignTimeout = setTimeout(() => {
            this.updateProgress();
            progressInterval = setInterval(() => {
                this.updateProgress();
            }, 1000);
        }, ms2NextSec);
    },
    stopTimers() {
        if (alignTimeout) {
            clearTimeout(alignTimeout);
            alignTimeout = null;
        }
        if (progressInterval) {
            clearInterval(progressInterval);
            progressInterval = null;
        }
        if (timeInterval) {
            clearInterval(timeInterval);
            timeInterval = null;
        }
    },
    clearDelState() {
        if (delTimeout) {
            clearTimeout(delTimeout);
            delTimeout = null;
        }
        delCount = false;
    },
    i() { // 打开关于
        this.clearDelState();
        this.ab = true;
    },
    info(idx) { // 打开详情
        this.clearDelState();
        nowi = idx;
        this.more = this.list[idx];
        this.more_show = true;
        this.updateProgress();
    },
    exit(a) { // 返回
        if (a === 'e' || (a && a.direction === 'right')) {
            this.clearDelState();
            if (this.ab || this.more_show) {
                this.more_show = false;
                this.more = {};
                this.ab = false;
            } else {
                this.$app.exit();
            }
        }
    },
    onBackPress() {
        this.exit('e');
        return true;
    },
    save() { // 持久化
        const saveObj = {
            list: this.list.map(e => ({ name: e.name, usr: e.usr, key: e.key }))
        };
        storage.set({
            key: dataKey,
            value: JSON.stringify(saveObj)
        });
    },
    onShow() {
        // 唤醒：将当前实例数据全量同步至全局变量，避免多次切前后台内存泄漏
        if ((!this.list || this.list.length === 0) && memoryCacheList && memoryCacheList.length > 0) {
            this.list = memoryCacheList;
            this.isLoaded = true;
        }
        this.startTimers();
    },
    onHide() {
        this.stopTimers();
        this.clearDelState();
    },
    onDestroy() {
        this.stopTimers();
        this.clearDelState();
    },
    del() { // 删除确认
        if (!delCount) {
            delCount = true;
            if (delTimeout) clearTimeout(delTimeout);
            delTimeout = setTimeout(() => {
                delCount = false;
                delTimeout = null;
            }, 1200);
            prompt.showToast({
                message: "再次点击确认删除",
                duration: 1200
            });
            return;
        }
        this.clearDelState();
        if (nowi >= 0 && nowi < this.list.length) {
            this.list.splice(nowi, 1);
            this.more_show = false;
            this.more = {};
            memoryCacheList = this.list;
            this.save();
            prompt.showToast({
                message: "已删除",
                duration: 1000
            });
        }
    }
};
</script>

